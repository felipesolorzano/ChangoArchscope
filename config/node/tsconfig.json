{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "../..",
    "outDir": "../../build/server"
  },
  "include": [
    "../../app/modules/**/*.ts",
    "../../core/**/*.ts",
    "../../bootstrap/**/*.ts",
    "../../routes/**/*.ts"
  ],
  "exclude": ["../../tests/**/*.ts", "../../build/server"]
}
