{
  "name": "chango-archsocope",
  "version": "0.1.0",
  "description": "Standalone architecture explorer and checker for Laravel-style PHP modules and React modules.",
  "type": "module",
  "bin": {
    "chango-archscope": "./bin/chango-archscope.mjs"
  },
  "files": [
    "app",
    "bin",
    "bootstrap",
    "build/server",
    "config",
    "public",
    "resources/js/react",
    "resources/views",
    "routes",
    "README.md"
  ],
  "scripts": {
    "serve": "node ./bin/chango-archscope.mjs serve",
    "dev:node": "npm run build:node && npm run serve",
    "start:node": "npm run serve",
    "graph": "node ./bin/chango-archscope.mjs graph",
    "check": "node ./bin/chango-archscope.mjs check",
    "build": "npm run build:node && npm run build:react",
    "build:node": "node -e \"require('node:fs').rmSync('build/server',{recursive:true,force:true})\" && tsc -p config/node/tsconfig.json",
    "prepublishOnly": "npm run build:node",
    "db:migrate": "tsx app/modules/shared/presentation/cli/runSqliteMigrationsCli.ts",
    "db:studio": "drizzle-kit studio --config config/drizzle.config.ts",
    "test": "npm run test:node && npm run test:react",
    "test:node": "vitest run --config config/node/vitest.config.ts",
    "test:react": "vitest run --config config/react/vitest.config.mjs",
    "test:watch:node": "vitest --config config/node/vitest.config.ts",
    "test:watch:react": "vitest --config config/react/vitest.config.mjs",
    "test:mutation": "npm run test:mutation:node && npm run test:mutation:react",
    "test:mutation:node": "stryker run config/node/stryker.conf.json",
    "test:mutation:react": "stryker run config/react/stryker.conf.mjs",
    "dev:react": "vite --config config/react/vite.config.mjs --host 0.0.0.0",
    "build:react": "vite build --config config/react/vite.config.mjs",
    "preview:react": "vite preview --config config/react/vite.config.mjs --host 0.0.0.0",
    "dev:ui": "vite --config config/react/vite.config.mjs --host 0.0.0.0",
    "build:ui": "vite build --config config/react/vite.config.mjs",
    "preview:ui": "vite preview --config config/react/vite.config.mjs --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "edge.js": "^6.5.1",
    "express": "^5.2.1",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.18"
  }
}
